{
  "name": "trendforge",
  "version": "2.4.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "workers/*"
  ],
  "scripts": {
    "dev":    "turbo dev",
    "build":  "turbo build",
    "test":   "vitest run",
    "seed":   "tsx scripts/seed-countries.ts",
    "health": "tsx scripts/check-scraper-health.ts",
    "migrate": "pnpm --filter @trendforge/database migrate:dev"
  },
  "devDependencies": {
    "turbo":   "^2.0.0",
    "tsx":     "^4.7.0",
    "vitest":  "^1.6.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.1.0"
}
